---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { translations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = translations.en.meta.title,
  description = translations.en.meta.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://addaudio.github.io/');
const ogImageURL = new URL('/icons/icon-512.png', Astro.site ?? 'https://addaudio.github.io/');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#AD8B73" />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="AddAudio" />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AddAudio" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Google Tag Manager & Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-PJ8X8F76"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GV8K50P47J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GV8K50P47J');
    </script>

    <!-- Prevent Theme FOUC before first paint -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('addaudio-theme');
          const theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : 'light';
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          if (theme === 'dark') {
            const meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#1E1916');
          }
          const savedLang = localStorage.getItem('addaudio-lang');
          if (savedLang) {
            document.documentElement.dataset.lang = savedLang;
          }
        } catch {
          // Ignore storage errors
        }
      })();
    </script>

    <!-- COI + Unified Offline PWA Service Worker -->
    <script is:inline src="/coi-serviceworker.js"></script>

    <!-- Page-specific Structured Data (JSON-LD) -->
    <slot name="head" />
  </head>
  <body>
    <Navbar currentPath={Astro.url.pathname} />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p style="margin: 0;" data-i18n="footer.privacyNote">
          100% client-side processing via WebAssembly. Your files never leave your device.
        </p>
        <nav class="footer-links" aria-label="Footer Navigation">
          <a href="/" data-i18n="nav.home">Home</a>
          <a href="/how-to-use/" data-i18n="nav.howToUse">How to Use</a>
          <a href="/#faq" data-i18n="nav.faqLink">FAQ</a>
          <a href="/privacy/" data-i18n="nav.privacy">Privacy</a>
          <a href="/hire-me/" data-i18n="nav.hireMe">Hire Me</a>
          <a href="https://kisharadilshan.gumroad.com/coffee" target="_blank" rel="noopener noreferrer" data-i18n="nav.supportCta">
            Support
          </a>
        </nav>
      </div>
    </footer>

    <!-- PWA Install Hint Modal (shown when native beforeinstallprompt isn't available) -->
    <div id="pwa-install-modal" class="pwa-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="pwa-modal-title" hidden>
      <div class="pwa-modal-card">
        <h2 id="pwa-modal-title" data-i18n="pwa.modalTitle">Install AddAudio Offline</h2>
        <p id="pwa-modal-body" data-i18n="pwa.desktopBody">
          Use your browser menu (Install AddAudio / Add to Home Screen) to keep this tool available 100% offline.
        </p>
        <button id="pwa-modal-close" type="button" class="btn-primary" style="width: 100%; min-height: 46px;" data-i18n="pwa.close">
          Got it
        </button>
      </div>
    </div>

    <!-- Lightweight Island Script for Navbar Controls (Theme, i18n, PWA) -->
    <script>
      import { initNavbarControls } from '../scripts/theme-pwa';
      initNavbarControls();
    </script>
  </body>
</html>
