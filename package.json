{
  "name": "addaudio",
  "version": "1.0.0",
  "description": "AddAudio — 100% client-side, privacy-first browser tool to add, replace, or mix audio into video using WebAssembly FFmpeg.",
  "type": "module",
  "homepage": "https://addaudio.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/addaudio/addaudio.github.io.git"
  },
  "scripts": {
    "sync:ffmpeg": "node scripts/sync-ffmpeg.mjs",
    "dev": "npm run sync:ffmpeg && astro dev",
    "build": "npm run sync:ffmpeg && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify:seo": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "astro": "^7.4.12",
    "coi-serviceworker": "^0.1.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3"
  }
}
